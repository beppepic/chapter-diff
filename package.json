{
  "name": "obsidian-chapter-diff",
  "version": "0.3.0",
  "description": "Compare the working version of an Obsidian note with any past Git commit, side by side with inline diff highlighting.",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "git",
    "diff",
    "writing"
  ],
  "author": "Beppe",
  "license": "MIT",
  "dependencies": {
    "@codemirror/merge": "^6.10.2",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.10"
  }
}
